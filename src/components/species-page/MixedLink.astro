---
import Link from "../Link.astro";
import MddText from "./MddText.astro";
import { createAutoLinkedTextParts } from "../../libs/taxon";

interface Props {
  text: string;
  isItalic?: boolean;
}

const { text, isItalic } = Astro.props as Props;
const textParts = createAutoLinkedTextParts(text);
---

{
  textParts.map((part) =>
    part.url ? (
      <Link
        url={part.url}
        label={part.url === part.text ? undefined : part.text}
      />
    ) : (
      <span class={isItalic ? "italic" : ""}>
        <MddText text={part.text} />
      </span>
    )
  )
}
