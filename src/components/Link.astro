---
import cntl from "cntl";

interface LinkProps {
  label?: string;
  url: string;
  extendClass?: string;
  openInNewTab: boolean;
}

const {
  label,
  url,
  extendClass,
  openInNewTab = false,
} = Astro.props as LinkProps;

const text = label ? label : url;

const linkClasses = cntl`
  underline
  text-spectra-800
  dark:text-spectra-200
  hover:text-spicy-mix-700
  dark:hover:text-spicy-mix-300
  transition-colors
  font-medium
  ${label ? "break-word" : "break-all"}
  overflow-clip
  text-ellipsis
  ${extendClass}
`;
---

<a
  class={linkClasses}
  href={url}
  target={openInNewTab ? "_blank" : "_self"}
  rel="noopener noreferrer"
  aria-label={label ? label : url}>{text}</a
>
