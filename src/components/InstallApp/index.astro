---
import cntl from "cntl";
import HeroCell from "./HeroCell.astro";
import SearchCell from "./SearchCell.astro";
import OfflineCell from "./OfflineCell.astro";
import CrossPlatformCell from "./CrossPlatformCell.astro";
import ExportsCell from "./ExportsCell.astro";

const sectionTitleClass = cntl`
  font-serif
  text-3xl
  lg:text-4xl
  font-semibold
  text-center
  mb-4
  mt-12
  text-spectra-950
  dark:text-spectra-50
`;
---

<div>
  <h2 class={sectionTitleClass}>Install the MDD App</h2>
  <p class="text-center text-spectra-700 dark:text-spectra-300 font-medium mb-10 max-w-6xl mx-auto">
    We build the app from the ground-up to compliment the existing MDD website. We match core features (e.g., species and synonym list), but also bring additional features where an app can provide a better experience.
  </p>
  <div
    class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6 max-w-6xl mx-auto px-4 mb-16"
  >
    <HeroCell />
    <SearchCell />
    <OfflineCell />
    <CrossPlatformCell />
    <ExportsCell />
  </div>
</div>
