---
import DiffTable, {
  type DiffTableColumn,
  type DiffTableRow,
} from "../../components/DiffTable.astro";
import PageDivider from "../../components/PageDivider.astro";
import Title from "../../components/Title.astro";
import MainPage from "../../layouts/MainPage.astro";
import Page from "../../layouts/Page.astro";
import PageHeader from "../../layouts/PageHeader.astro";
import { getAllTaxonomyChanges } from "../../../db/diffs";
import { formatDate } from "../../libs/metadata";

const columns: DiffTableColumn[] = [
  { key: "version", label: "Version" },
  { key: "releaseDate", label: "Release date" },
  { key: "oldName", label: "Old name" },
  { key: "newName", label: "New name" },
  { key: "category", label: "Category" },
  { key: "comments", label: "Comments" },
  { key: "reference", label: "Reference" },
];

const rows = getAllTaxonomyChanges().map((change) => ({
  ...change,
  version: `v${change.version}`,
  releaseDate: formatDate(change.releaseDate) ?? "Date unavailable",
})) as unknown as DiffTableRow[];
---

<Page title="MDD Taxonomy Changes since v2" isIndexed={false}>
  <MainPage isIndexed={false}>
    <PageHeader>
      <Title slot="title" bottomPadding={8}>MDD Taxonomy Changes since v2</Title>
      <div slot="description">
        <p>
          All recorded taxonomy changes from releases after MDD v2, including the release and date in which each change was introduced.
        </p>
      </div>
    </PageHeader>
    <PageDivider />

    <div class="mx-auto max-w-screen-2xl pb-12">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 text-sm text-spectra-700 dark:text-spectra-300">
        <p>{rows.length.toLocaleString()} taxonomy changes</p>
        <a class="underline hover:text-spicy-mix-700 dark:hover:text-spicy-mix-300" href="/releases">
          Back to release notes
        </a>
      </div>
      <DiffTable columns={columns} rows={rows} />
    </div>
  </MainPage>
</Page>
